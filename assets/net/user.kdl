        doc "Lock/favorite flag.  // UNVERIFIED: dJNpLc81 vs DbMVG16I order not yet confirmed against a capture; both default 0."
    }

    field disp_order type="i32::str" {
        key "DbMVG16I"
        doc "Display order in the item list.  // UNVERIFIED: see favorite_flg note."
    }
}

