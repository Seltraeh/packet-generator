json UserUnitInfo {
    doc "Player-owned unit records."

    field user_unit_id type="u32::str" {
        key "edy7fq3L"
        doc """
        Unique id attributed to a specific unit of a given user.
        Duplicates of the same unit will receive unique user unit ids.
        """
    }

    field user_id type="str" {
        key "h7eY3sAK"
        doc "ID of the user for this session."
    }

    field unit_id type="u32::str" {
        key "pn16CNah"
        doc """
        Unique identifier for the unit's archive record.
        Used to look up this unit in the MST assets.
        """
    }

    field unit_type_id type="u32::str" {
        key "nBTx56W9"
        doc """
        Specifies the unit type, e.g. Lord, Anima, Breaker, Guardian, or Oracle.
        TODO: Figure out which numeric value maps to each type.
        """
    }

    field unit_lvl type="u32::str" {
        key "D9wXQI2V"
        doc "TODO"
    }

    field exp type="i32::str" {
        key "d96tuT2E"
        doc "TODO"
    }

    field total_exp type="i32::str" {
        key "gQInj3H6"
        doc "TODO"
    }

    field base_hp type="u32::str" {
        key "e7DK0FQT"
        doc """
        Current HP stat for this unit before imp/stat-up bonuses.
        Includes level-based stat growth because this client passes
        base_hp into GameUtils::getUnitHp(base_hp, unit_lvl, ...),
        which currently returns base_hp unchanged. This suggests the
        server is expected to store the unit's level-adjusted normal
        HP in this bucket. Naturally, this applies to all base_* stats.
        """
    }

    field add_hp type="i32::str" {
        key "cuIWp89g"
        doc "TODO"
    }

    field ext_hp type="u32::str" {
        key "TokWs1B3"
        doc """
        Imp/stat-up HP bucket.
        We should cap this against the unit's HP stat-up limit from MST data.
        """
    }

    field limit_over_hp type="i32::int" {
        key "ISj9u5VL"
        doc "TODO"
    }

    field base_atk type="u32::str" {
        key "67CApcti"
        doc """
        Current ATK stat for this unit before imp/stat-up bonuses.
        See base_hp for why base_* stores the unit's level-adjusted normal stats.
        """
    }

    field add_atk type="i32::str" {
        key "RT4CtH5d"
        doc "TODO"
    }

    field ext_atk type="u32::str" {
        key "t4m1RH6Y"
        doc """
        Imp/stat-up ATK bucket.
        We should cap this against the unit's ATK stat-up limit from MST data.
        """
    }

    field limit_over_atk type="i32::int" {
        key "D6bKH5eV"
        doc "TODO"
    }

    field base_def type="u32::str" {
        key "q08xLEsy"
        doc """
        Current DEF stat for this unit before imp/stat-up bonuses.
        See base_hp for why base_* stores the unit's level-adjusted normal stats.
        """
    }

    field add_def type="i32::str" {
        key "GcMD0hy6"
        doc "TODO"
    }

    field ext_def type="u32::str" {
        key "e6mY8Z0k"
        doc """
        Imp/stat-up DEF bucket.
        We should cap this against the unit's DEF stat-up limit from MST data.
        """
    }

    field limit_over_def type="i32::int" {
        key "3CsiQA0h"
        doc "TODO"
    }

    field base_rec type="u32::str" {
        key "PWXu25cg"
        doc """
        Current REC stat for this unit before imp/stat-up bonuses.
        See base_hp for why base_* stores the unit's level-adjusted normal stats.
        """
    }

    field add_rec type="i32::str" {
        key "C1HZr3pb"
        doc "TODO"
    }

    field ext_rec type="u32::str" {
        key "X6jf8DUw"
        doc """
        Imp/stat-up REC bucket.
        We should cap this against the unit's REC stat-up limit from MST data.
        """
    }

    field limit_over_rec type="i32::int" {
        key "XJs2rPx0"
        doc "TODO"
    }

    field unk type="i32::str" {
        key "xujp1nz2"
        doc "TODO"
    }

    field element type="str" {
        key "iNy0ZU5M"
        doc "TODO"
    }

    field leader_skill_id type="i32::str" {
        key "oS3kTZ2W"
        doc "TODO"
    }

    field bb_id type="str" {
        key "nj9Lw7mV"
        doc "Denotes the bb skill id for this unit."
    }

    field bb_lvl type="u32::str" {
        key "3NbeC8AB"
        doc "Denote bb skill level; max should be level 10."
    }

    field sbb_id type="str" {
        key "iEFZ6H19"
        doc """
        Denotes the sbb skill id for this unit.
        Leave empty if not unlocked.
        """
    }

    field sbb_lvl type="u32::str" {
        key "RQ5GnFE2"
        doc "Denote sbb skill level; max should be level 10."
    }

    field equipitem_frame_id type="i32::str" {
        key "0R3qTPK9"
        doc "TODO"
    }

    field equipitem_id type="i32::str" {
        key "Ge8Yo32T"
        doc "TODO"
    }

    field equipitem_frame_id2 type="i32::str" {
        key "RXfC31FA"
        doc "TODO"
    }

    field equipitem_id2 type="i32::str" {
        key "mZA7fH2v"
        doc "TODO"
    }

    field received_order type="u32::str" {
        key "Bvkx8s6M"
        doc """
        Numeric acquired-sort key.
        The client only uses this value for acquired-order unit sorting, so the
        server populates it from the monotonically increasing user_unit_id
        instead of storing a separate timestamp.
        """
    }

    field unk2 type="i32::str" {
        key "DbMVG16I"
        doc "TODO"
    }

    field is_new type="bool::str" {
        key "dJNpLc81"
        doc """
        Client-visible new badge for an owned unit row.

        This only marks a newly obtained owned unit, not whether the unit is
        new to the player.
        """
    }

    field extra_passive_skill_id type="i32::str" {
        key "cP83zNsv"
        doc "TODO"
    }

    field extra_passive_skill_id2 type="i32::str" {
        key "LjY4DfRg"
        doc "TODO"
    }

    field add_extra_passive_skill_id type="i32::str" {
        key "T4rewHa9"
        doc "TODO"
    }

    field unit_img_type type="i32::int" {
        key "2pAyFjmZ"
        doc "TODO"
    }
     // # TODO: is this really a str?
    field omni_level type="i32::int" {
        key "49sa3sld"
        doc "TODO"
    }

    field ext_count type="i32::int" {
        key "5gXxT7LZ"
        doc "TODO"
    }

    field fe_bp type="i32::str" {
        key "bFQbZh3x"
        doc "TODO"
    }

    field fe_used_bp type="i32::str" {
        key "3RgneFpP"
        doc "TODO"
    }

    field fe_max_usable_bp type="i32::str" {
        key "GIO9DTif"
        doc "TODO"
    }

    field fe_skill_info type="str" {
        key "Fnxab5CN"
        doc "TODO"
    }

}

