json UnitEvoReq {
    doc "Evolve a base unit by consuming evo materials.  Wire root keys (UnitEvoRequest::createBody): login IKqx1Cn9, base unit(s) Km35HAXv, evolution target I82p0wCL, zel cost mCE3rUu5, element/material units 8Z2NQrx1."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field units type="[UnitEvoUnitEntry]" {
        key "Km35HAXv"
        doc "Base unit(s) being evolved (role \"1\" = base)."
    }

    field target type="[UnitEvoTargetEntry]" {
        key "I82p0wCL"
        doc "Evolution target — the unit_mst id the base evolves into."
    }

    field zel_cost_list type="[UnitEvoZelEntry]" {
        key "mCE3rUu5"
        doc "Zel cost line items for the evolution."
    }

    field elem_units type="[UnitEvoElemEntry]" {
        key "8Z2NQrx1"
        doc "Evolution material (element) units consumed."
    }
}

json UnitEvoResp {
    doc "UnitEvo response (response_class=UnitOpeEvoResponse).  Carries the evolution result (I82p0wCL), a full unit-cache rebuild (4ceMWH6k), the updated team info (fEi17cnx), and the reinforce/stat animation payload (xZH6EIQ7)."

    field evo_result type="[EvoResultEntry]" {
        key "I82p0wCL"
        doc "Which MST id the base evolved into (and the evolved unit's DB id)."
    }

    field unit_refresh type="[UserUnitInfo]" {
        key "4ceMWH6k"
        doc """
        FULL-REPLACE unit cache rebuild — the ONLY key that can change a unit
        the client already owns, because its ctor flag makes readParam call
        removeAllObjects() before re-adding.  Send the COMPLETE roster here or
        the client loses every unit omitted.

        Evolution needs this for the same reason fusion does: the client has no
        local apply path.  It never rewrites the evolved unit and never drops
        the consumed materials, and it issues no request afterwards, so without
        this the unit list keeps showing the pre-evolution form until Home.

        The historical note here said DO NOT USE 4ceMWH6k because it soft-locked
        the result screen.  That test is superseded — the same key is confirmed
        working on UnitMix (2026-08-10) now that lvup_status is a valid table;
        the earlier build sent "1", which crashes the result scene by itself.
        The removeAllObjects release() hazard is still the thing to suspect if a
        result screen ever does hang on this.

        OPTIONAL ON PURPOSE: a plain vector serialises as "4ceMWH6k": [] when
        unset, and an empty full-replace list is the one payload that could
        clear the roster outright.
        """
        optional #true
    }

    field ope_result type="[UnitOpeResult]" {
        key "1ZbHB6Im"
        doc """
        DO NOT POPULATE THIS FOR EVOLUTION — the evolution result screen never
        reads it.  UnitOpeResult::shared() has exactly one scene consumer,
        UnitMixPlayScene::parseMixResult (the other two callers are the response
        ctor and its readParam), and UnitOpeResult is a SINGLETON, so writing it
        from an evolution reply mutates state a fusion scene may later read.
        Evolution reports through its own class instead: I82p0wCL ->
        UnitOpeEvoResponse -> UnitEvoInfo (see EvoResultEntry).
        Retained only because the field is shared with UnitMixResp.
        """
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Updated team info (zel) after the evolution."
    }

    field reinforce type="[UnitReinforceEntry]" {
        key "xZH6EIQ7"
        doc "Reinforcement/level-up animation + stat payload."
    }
}

json UnitMixReq {
    doc "Fuse (mix) material units into a base unit for XP.  Wire root keys: login IKqx1Cn9, units Km35HAXv (role \"1\" = base receiving XP, \"2\" = material consumed), zel cost mCE3rUu5."

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field units type="[UnitMixUnitEntry]" {
        key "Km35HAXv"
        doc "Base + material units (role \"1\" = base, \"2\" = material)."
    }

    field zel_cost_list type="[UnitMixZelEntry]" {
        key "mCE3rUu5"
        doc "Zel cost line items for the fusion."
    }
}

json UnitMixResp {
    doc "UnitMix (Power Fusion) response.  Carries the reinforce/stat animation payload (xZH6EIQ7), an incremental unit-cache update for the fused base unit (qC2tJs4E), and the updated team info (fEi17cnx)."

    field reinforce type="[UnitReinforceEntry]" {
        key "xZH6EIQ7"
        doc "Reinforcement/level-up animation + stat payload."
    }

    field unit_update type="[UserUnitInfo]" {
        key "qC2tJs4E"
        doc """
        INERT for fusion — kept only so the shape stays documented.  This key
        is INSERT-IF-ABSENT, not an update: UserUnitInfoResponse::readParam
        ends with

            v187 = UserUnitInfoList::exist(list, userUnitId);
            if ( (v187 & 1) == 0 ) { ...; addObject(...); return 1; }
            return 1LL;              // already owned -> entry DISCARDED

        and a fusion base unit is always already owned, so whatever we put
        here is parsed and then dropped.  It is the right key for genuinely
        NEW units (drops, gacha).  Use unit_refresh below to actually change
        an owned unit.
        """
    }

    field unit_refresh type="[UserUnitInfo]" {
        key "4ceMWH6k"
        doc """
        FULL-REPLACE unit cache rebuild — the ONLY key that can change a unit
        the client already owns, because its ctor flag makes readParam call
        removeAllObjects() before re-adding.  Send the COMPLETE roster here or
        the client loses every unit omitted.

        CONFIRMED WORKING on the fusion reply, 2026-08-10: the fusion menu shows
        the new level and the fodder are gone with no trip to Home.
        The one caveat to remember is that removeAllObjects() release()s every
        CCObject in both containers, so any scene still holding a raw
        UserUnitInfo* dangles.  This key soft-locked the result screen once
        (2026-08-09), but that build also sent lvup_status "1", which crashes
        parseMixResult by itself.  If a result screen ever hangs on this again,
        the release() is the mechanism to suspect.

        Why it is here at all: the client has NO local apply path.  It never
        updates the fused unit and never removes the fodder — removeObject's
        only real callers are the FrontierGate/FGPlus friend lists and
        removeObjectWithUserUnitID has none.  It also requests nothing after a
        fusion.  So without this key the fusion menu stays stale until Home.

        OPTIONAL ON PURPOSE, and it must stay that way.  A plain vector
        serialises as "4ceMWH6k": [] when unset — qC2tJs4E demonstrably does
        exactly that today — and an empty full-replace list is the one payload
        that could clear the client's roster outright.  As std::optional the
        key is absent entirely unless we mean it.
        """
        optional #true
    }

    field ope_result type="[UnitOpeResult]" {
        key "1ZbHB6Im"
        doc "The result-screen payload — before/after levels and exp for the level-up animation.  See UnitOpeResult in net/unit.kdl."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Updated team info (zel) after the fusion."
    }
}

json UnitSellReq {
    doc "Sell one or more user_units for zel.  Wire root keys: login IKqx1Cn9, units Km35HAXv."

