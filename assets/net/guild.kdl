// Guild -- recovered 2026-09-17 from GuildInfoResponse::readParam @0x1C536E0.
//
// Every field below is the key/setter pair that readParam's strcmp chain
// actually dispatches on, read straight out of the arm64 libgame.so, so the
// names are the client's own rather than guesses. The 45 guild GroupId/AES
// pairs that go with them come from tools/bin/so_groupids.py.
//
// GuildInfo is a SINGLETON on the client, filled by whichever reply carries it.
//
// Note the shape this implies for the simulated guild: the client already
// tracks a LEVEL, an EXPERIENCE total, a PRESTIGE POINT balance and a RANK
// separately, so passive daily growth has somewhere real to land -- nothing new
// needs inventing on the wire for it.

json GuildInfo {
    doc "One guild, as the Guild screen draws it."

    field id type="i32::str" {
        key "sD73jd20"
        doc "setGuildId.  The guild's own id; joins every other guild request."
    }

    field name type="str" {
        key "s35idar9"
        doc "setName.  The guild's display name, chosen at creation.  ⚠ The same wire key carries the ticket name on UnitSelectorGachaMst -- different context, different meaning."
    }

    field description type="str" {
        key "qp37xTDh"
        doc "setDescription.  The free-text blurb shown on the guild's page and in search results."
    }

    field guild_art_id type="i32::str" {
        key "dDKCN293"
        doc "setGuildArtId.  Which crest the guild flies; joins to GuildInsigniaMst.id, which readParam populates from this very same key in its second block."
    }

    field level type="i32::str" {
        key "osidufj5"
        doc "setLevel.  Guild level.  GuildInsigniaMst reuses this key as required_guild_level, which is what gates a crest."
    }

    field rank type="i32::str" {
        key "P_RANK"
        doc "setRank.  ⚠ NOT a hashed key -- the client compares the literal string \"P_RANK\", unlike every other field here.  Sending the hashed-looking variants does nothing."
    }

    field prestige_point type="i32::str" {
        key "sc83dkh3"
        doc "setPrestigePoint.  The guild's own currency balance -- distinct from the guild TOKEN (present type 8002), which is a per-player item the present box cannot yet pay."
    }

    field members_count type="i32::str" {
        key "SivJ9sL9"
        doc "setMembersCount.  Members currently in the guild, drawn on the roster header."
    }

    field master_name type="str" {
        key "aBcniqj8"
        doc "setMasterName.  Handle of the guild master, shown without needing the member list."
    }

    field experience type="i32::str" {
        key "Siv49s0l"
        doc "setExperience.  Total guild experience."
    }

    field experience_obtained type="i32::str" {
        key "39bDai1y"
        doc "setExperienceObtained.  Experience earned toward the CURRENT level, i.e. the progress bar's numerator."
    }

    field board_flag type="bool::int" {
        key "b6D19bg9"
        doc "setBoardFlag.  Whether the guild board has anything unread."
    }

    field create_date type="str" {
        key "o94cnA8P"
        doc "setCreateDate.  When the guild was founded; a display string, not a timestamp."
    }
}

// ---------------------------------------------------------------------------
// Guild creation and membership -- the "start a guild and invite your friends"
// slice.  Every key below is Binary-confirmed: request shapes come from the
// producing createBody, response shapes from the class
// GameResponseParser::getResponseObject @0x1392568 dispatches the key to.
//
// ⚠ TWO ID REPRESENTATIONS, AND THEY ARE NOT INTERCHANGEABLE.
//   GuildMemberUpdate and GuildRecomendedMember key members by h7eY3sAK as a
//   STRING -- the same id the friend roster uses.
//   GuildInviteManage keys them by 7ad38bad as an INT
//   (setUserIdAndAction(int,int) @0x1C53DA0).
// The string path is the one this server can serve; the int path carries a
// message-box invite id the live game minted.  See GuildInviteManageReq.
// ---------------------------------------------------------------------------

json GuildCreateNode {
    doc "The guild being created.  From GuildCreateRequest::createBody @0x1C4F5E8."

    field guild_id type="str" {
        key "sD73jd20"
        doc "ALWAYS EMPTY on create -- createBody passes the empty string literal at 0x2319621, not the caller's guild.  The id is the server's to assign; the node shape is simply shared with the edit path."
    }

    field name type="str" {
        key "s35idar9"
        doc "The name the player typed.  addParam(const char*, std::string) @0x1C4F6F0."
    }

    field description type="str" {
        key "qp37xTDh"
        doc "The blurb the player typed.  addParam(const char*, std::string) @0x1C4F7A0."
    }

    field guild_art_id type="str" {
        key "dDKCN293"
        doc "Chosen crest, joining GuildInsigniaMst.id.  QUOTED: createBody uses the std::string addParam overload @0x1C4F7D0, even though GuildInfo reads the same key back through setGuildArtId(int)."
    }
}

json GuildCreateReq {
    doc "Request for GuildCreate (g298Da10)."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field guild type="[GuildCreateNode]::size(1)" {
        key "IkdSufj5"
        doc "One node -- createBody calls addGroup then a single addNode.  Same wrapper key the reply carries GuildInfo under."
    }
}

json GuildInfoReq {
    doc "Request for GuildInfo (138ba8d4), GuildJoinedList (3890ab5j) and GuildRecomendedMember (ja5Enusw).  All three createBodies are 44 bytes -- the three BaseRequest tags and nothing else -- so none carries a field of its own."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }
}

json GuildInfoResp {
    doc """
    The guild, as GuildInfoResponse @0x1C536E0 reads it.

    A SINGLETON: readParam performs no list operation at all, so this is one
    full row or nothing.  A partial row leaves the previous values standing
    rather than clearing them.
    """

    field guild type="[GuildInfo]" {
        key "IkdSufj5"
        doc """
        The caller's guild -- exactly one row, or NONE.

        ⚠ A PLAIN LIST, NOT `::size(1)`, and the difference is load-bearing here.
        `::size(1)` embeds the object and serialises it through
        pkg::glaze::single_array, which writes `[value]` unconditionally and
        knows nothing about std::optional -- so a player with no guild was
        getting an all-zero GuildInfo, which is not "no guild", it is guild 0
        with an empty name.  GuildInfoResponse @0x1C536E0 is a singleton that
        performs NO list operation, so that row would be written into the
        client's UserGuildInfo and stand until something replaced it.

        As a list the same one-row wire shape is emitted when there IS a guild,
        and an empty array when there is not -- and a zero-row array never
        reaches readParam at all, so it cannot write anything.
        """
    }

    field members type="[GuildMemberInfo]" {
        key "csIuech30"
        doc "The guild's roster, sent with the guild itself so the Hall has rows before the player can tap one.  See GuildMembersInfoResp."
    }

    field creation_info type="[GuildCreationInfo]" {
        key "jKeiqDbl"
        doc """
        What founding a guild costs, carried on THIS reply.

        ⚠ There is no GuildCreateCostRequest -- libgame.so has
        GuildCreateCostResponse and no matching request class at all, so nothing
        ever asks for the fee on its own.  It has to arrive attached to a reply
        the player already triggers, and the guild screen is the one that needs
        it: a Summoner with no guild is shown the founding prompt there.

        Modelled as a plain list rather than ::size(1) so it can be omitted for
        a player who already has a guild and cannot spend it.
        """
    }
}

json GuildCreationInfo {
    doc "What founding a guild costs.  From GuildCreateCostResponse::readParam @0x1C4F434 -- the whole class is these two fields."

    field currency_type type="i32::str" {
        key "ODdetio0"
        doc "setCurrencyType.  Which currency the creation fee is charged in."
    }

    field required_amount type="i32::str" {
        key "HFAI8WT4"
        doc "setRequiredAmount.  How much of it."
    }
}

json GuildRecomendedMemberInfo {
    doc """
    One Summoner the player may invite.

    ⚠ SPELLED "Recomended", one m, to match the client class name rather than
    silently correcting it -- the symbol stays greppable.

    THE CANDIDATES ARE FRIENDS.  Three of the seven setters say so outright
    (setFriendUserUnitID, setFriendUserUnitLevel, setFriendUserImageType), which
    makes "invite your friends into your guild" recovered behaviour rather than
    a design choice.
    """

    field user_id type="str" {
        key "h7eY3sAK"
        doc "setUserID, a std::string -- the same id the friend roster is emitted under, so a roster row can be offered here directly."
    }

    field user_name type="str" {
        key "B5JQyV8j"
        doc "setUserName.  Same key the friend roster uses for a handle."
    }

    field user_level type="i32::str" {
        key "LKSVU2sl"
        doc "setUserLevel.  The candidate's team level."
    }

    field friend_unit_id type="i32::str" {
        key "1ctR6GHC"
        doc "setFriendUserUnitID.  The unit on their card -- the helper they field."
    }

    field friend_unit_level type="i32::str" {
        key "8Ix0Soup"
        doc "setFriendUserUnitLevel.  That unit's level."
    }

    field friend_image_type type="i32::str" {
        key "JmLLHcDv"
        doc "setFriendUserImageType.  Which art variant of the card unit to draw."
    }

    field last_online_time type="i64::str" {
        key "93nclsc8"
        doc "setLastOnlineTime, a long -- seconds, and the only 64-bit field in the class."
    }
}

json GuildRecomendedMemberResp {
    doc """
    Response for GuildRecomendedMember (ja5Enusw).

    ⚠ A FULL REPLACE.  readParam @0x1C64A38 calls removeAllObjects, so every
    send must carry the COMPLETE candidate list -- a partial send deletes the
    rest, the same trap as the unit dictionary and the Social list.
    """

    field members type="[GuildRecomendedMemberInfo]" {
        key "fRaBu6et"
        doc "Every invitable Summoner, in full."
    }
}

json GuildTargetNode {
    doc "A guild named by id alone."

    field guild_id type="i32::int" {
        key "sD73jd20"
        doc "Unquoted -- GuildMemberUpdateRequest::createBody uses addParam(const char*, int) here, unlike the create path which sends the same key as a string."
    }
}

json GuildMemberEditNode {
    doc "One member being acted on.  From GuildMemberUpdateRequest::createBody @0x1C56448, which pairs with setMemberEditValue(std::string, int) @0x1C563FC."

    field user_id type="str" {
        key "h7eY3sAK"
        doc "Who.  A std::string, matching the roster and the recommended list."
    }

    field value type="str" {
        key "gr48vsdJ"
        doc "The member's TYPE -- their rank inside the guild, not an action code.  Resolved by GuildMembersInfoResponse, which reads this same key back through setMemberType @0x1C572FC.  QUOTED on the wire despite setMemberEditValue taking an int, because createBody uses the std::string addParam overload.  // UNVERIFIED: the type vocabulary itself (master / officer / member) is still not recovered."
    }
}

json GuildMemberUpdateReq {
    doc "Request for GuildMemberUpdate (ad81b8at).  TWO groups, not one."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field guild type="[GuildTargetNode]::size(1)" {
        key "IkdSufj5"
        doc "Which guild."
    }

    field members type="[GuildMemberEditNode]" {
        key "csIuech30"
        doc "The members being edited; one node each."
    }
}

// ⚠ aj38Jk10 IS TWO THINGS.  Below it is the REQUEST group GuildInviteManage
// sends its accept/decline decisions under -- two ints per node.  It is ALSO the
// RESPONSE key GameResponseParser dispatches to GuildJoinRequestInfoResponse
// @0x1C54530, which reads 33 keys: the member card again, plus 7ad38bad,
// SL7ySqi8 and xvkLFco0.  That response is the list of Summoners who have
// APPLIED to join, which is the mirror of the invite the message box delivers.
//
// Not modelled, deliberately: nobody can apply to a guild on this server, so the
// screen has no rows to draw and modelling 33 fields for it would be
// speculative. tools/bin/kdl_response_audit.py reports the key as a gap because
// its matcher only knows the request side; that report is expected, not a bug.

json GuildInviteManageNode {
    doc "One accept/decline decision.  From setUserIdAndAction(int, int) @0x1C53DA0."

    field user_id type="i32::int" {
        key "7ad38bad"
        doc "⚠ AN INT, not the string id every other guild request uses.  GuildDetailScene::touchBegan @0x1DA9AC0 fills it from MessageBoxInfo::getGuildInviteID(), so it is an INVITE id travelling in the message box, not a Summoner id."
    }

    field action type="i32::int" {
        key "ad8D1kqP"
        doc "1 = accept, 0 = decline.  Both constants read off the callers: GuildDetailScene::touchBegan and GuildRequestsListScene::updateEvent pass mov w2,#1 at 0x1DA9AD8 and 0x1E4B7B0, and the reject loop passes wzr at 0x1E4B900."
    }
}

json GuildInviteManageReq {
    doc """
    Request for GuildInviteManage (1D8bba8D) -- the RECEIVING half of an invite.

    ⚠ NOT REACHABLE ON THIS SERVER, and modelled anyway so the gap is explicit
    rather than an unexplained hole in the guild set.  The invite id comes from
    the client message box and is an integer; this server has no numeric account
    ids and no message-box invite channel, and the Summoners being invited are
    simulated, so nothing ever sends the player an invite to accept.  Joining
    here runs the other way, through GuildMemberUpdate, whose ids are strings we
    actually own.
    """

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field nodes type="[GuildInviteManageNode]" {
        key "aj38Jk10"
        doc "One node per decision; createBody loops the vector at +0x20 adding a node each time."
    }
}

// ---------------------------------------------------------------------------
// The message inbox -- recovered 2026-09-17 from MessageInboxResponse::readParam
// @0x1C69AE8 and InboxMessageManageRequest::createBody @0x1C694A0.
//
// It lives in guild.kdl because a guild INVITE is a message: the class carries a
// whole guild alongside the text, and setGuildInviteID's key (7ad38bad) is the
// same one GuildInviteManage sends back to accept or decline.  That is the
// receiving half of the invite loop.
// ---------------------------------------------------------------------------

json MessageInboxInfo {
    doc """
    One message.  MessageBoxInfo on the client.

    Every guild field here is the SAME key the standalone GuildInfo uses, because
    an invite has to draw the guild it is inviting you to without a second
    request -- the message carries a copy.
    """

    field message_id type="i32::str" {
        key "78Zema70"
        doc "setMessageID.  What InboxMessageManage names to act on a message."
    }

    field message_date type="str" {
        key "KjS8hhHS"
        doc "setMessageDate.  A display string, not a timestamp."
    }

    field message_type type="i32::str" {
        key "3e9aGpus"
        doc "setMessageType.  ⚠ The SAME key the GME error envelope uses for its error code -- different class, different direction, unrelated meaning.  // UNVERIFIED: the type vocabulary is not recovered."
    }

    field message_action type="i32::str" {
        key "oohpPLCt"
        doc "setMessageAction.  // UNVERIFIED: which actions the message offers; not yet traced to a consumer."
    }

    field message_title type="str" {
        key "y53KRhOb"
        doc "setMessageTitle.  The subject line in the list."
    }

    field message_content type="str" {
        key "bQvVOkkR"
        doc "setMessageContent.  The body."
    }

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildId.  The guild this message is about; 0 when it is not a guild message."
    }

    field guild_name type="str" {
        key "s35idar9"
        doc "setName.  The guild's name, copied into the message."
    }

    field guild_description type="str" {
        key "qp37xTDh"
        doc "setDescription.  The guild's blurb, copied into the message."
    }

    field guild_art_id type="i32::str" {
        key "dDKCN293"
        doc "setGuildArtId.  The guild's crest."
    }

    field guild_level type="i32::str" {
        key "osidufj5"
        doc "setLevel.  The guild's level."
    }

    field guild_rank type="i32::str" {
        key "P_RANK"
        doc "setRank @0x1C69FE4.  ⚠ Literal, unhashed, six characters -- the same odd key GuildInfo uses, and the same reason an 8-character key sweep misses it."
    }

    field guild_prestige_point type="i32::str" {
        key "sc83dkh3"
        doc "setPrestigePoint.  The guild's currency balance."
    }

    field guild_members_count type="i32::str" {
        key "SivJ9sL9"
        doc "setMembersCount.  How many are already in."
    }

    field guild_master_name type="str" {
        key "aBcniqj8"
        doc "setMasterName.  Who is inviting."
    }

    field guild_create_date type="str" {
        key "o94cnA8P"
        doc "setCreateDate.  When the inviting guild was founded -- the message carries it so the invite can show the guild's age without a second request, the same reason it copies the name and crest."
    }

    field guild_invite_id type="i32::str" {
        key "7ad38bad"
        doc "setGuildInviteID @0x1C6A10C.  THE INVITE HANDLE: GuildDetailScene::touchBegan @0x1DA9AC0 reads it straight back out with getGuildInviteID() and hands it to GuildInviteManage as its user_id.  That is why that request takes an int."
    }
}

json MessageInboxResp {
    doc """
    The inbox.

    ⚠ A FULL REPLACE: readParam @0x1C69AE8 calls removeAllObjects, so a send must
    carry every message.  An EMPTY list is safe and means "nothing here" -- a
    zero-row array never reaches readParam, so it clears nothing either.
    """

    field messages type="[MessageInboxInfo]" {
        key "D9dkXSPY"
        doc "Every message, in full."
    }
}

json InboxMessageManageNode {
    doc "One message being acted on.  From setMessageIdAndAction(int, int) @0x1C69388, the same shape GuildInviteManage uses for invites."

    field message_id type="i32::int" {
        key "78Zema70"
        doc "Which message.  Unquoted -- addParam(const char*, int)."
    }

    field action type="i32::int" {
        key "Hhgi79M1"
        doc "What to do with it.  ⚠ This key is also the OUTER envelope's GroupId field (handbook 4); inside this node it is the action, and the two have nothing to do with each other.  // UNVERIFIED: the action vocabulary is not recovered."
    }
}

json InboxMessageManageReq {
    doc "Request for InboxMessageManage (rYSfaC4P) -- opening or acting on the message box."

    field login_info type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login info identifying the current user."
    }

    field nodes type="[InboxMessageManageNode]" {
        key "YBsNO3cI"
        doc "One node per message acted on; createBody loops its vector adding a node each time."
    }
}

// ---------------------------------------------------------------------------
// The guild roster -- GuildMembersInfoResponse::readParam @0x1C56648.
//
// ⚠ THE KEY IS NINE CHARACTERS.  `csIuech30` went unseen for a whole pass
// because the dispatch sweep matched exactly eight-character keys; combined
// with P_RANK at six, that assumption has now hidden three real fields.  The
// sweep is widened (tools/bin/so_response_map.py) and finds eight more keys
// across the protocol than it did.
//
// ⚠ AND IT IS THE SAME KEY GuildMemberUpdate SENDS ITS EDITS UNDER.  Request
// and response share it, as they do for IkdSufj5.
//
// MOST OF THIS IS A SUMMONER CARD.  23 of the 37 keys are the same ones
// FriendInfo uses for a borrowable helper, and the names here are taken from
// net/friends.kdl on that basis -- key identity within the same card family,
// not an independent trace of each setter.  The genuinely guild-specific
// fields are member_type, cp_points, tokens, active_guild_deck and last_online.
// ---------------------------------------------------------------------------

json GuildMemberInfo {
    doc "One member of a guild, as the Guild Hall roster draws them."

    field guild_id type="i32::str" {
        key "sD73jd20"
        doc "setGuildId @0x1C566D0.  Which guild this row belongs to."
    }

    field user_id type="str" {
        key "h7eY3sAK"
        doc "setUserID @0x1C56764.  A std::string -- the same id the friend roster and GuildMemberUpdate use."
    }

    field handle_name type="str" {
        key "B5JQyV8j"
        doc "setHandleName @0x1C56808."
    }

    field team_lv type="i32::str" {
        key "2Fh3J7ng"
        doc "setTeamLv @0x1C56844."
    }

    field friend_id type="str" {
        key "98WfKiyA"
        doc "setFriendID @0x1C568D8.  Present because a guild member may also be a friend; the Hall shows that."
    }

    field friend_message type="str" {
        key "bM7RLu5K"
        doc "setFriendMessage @0x1C5697C."
    }

    field member_type type="i32::str" {
        key "gr48vsdJ"
        doc """
        setMemberType @0x1C572FC -- the member's RANK inside the guild.

        This resolves what GuildMemberUpdate's `value` carries: the request and
        this response share the key, so an edit sets a member's type rather than
        naming an invite/kick action, which is what an earlier pass could not
        determine.  // UNVERIFIED: the type vocabulary (master / officer /
        member) is still not recovered -- no consumer has been read.
        """
    }

    field cp_points type="i32::str" {
        key "9SVsdnwl"
        doc "setCpPoints @0x1C57328.  Contribution points; the Hall has a CP Ranking button that reads them."
    }

    field tokens type="i32::str" {
        key "23b6d2ia"
        doc "setTokens @0x1C57400.  The member's guild-token balance.  Guild tokens are present type 8002, which the present box still cannot pay -- see the present-type notes."
    }

    field active_guild_deck type="i32::str" {
        key "Z0Y4RoD7"
        doc "setActiveGuildDeck @0x1C5742C.  Which of their guild decks is fielded."
    }

    field last_online type="i64::str" {
        key "93nclsc8"
        doc "setLastOnline @0x1C573C4, a long -- the only 64-bit field here.  Same key GuildRecomendedMemberInfo uses."
    }

    field arena_rank_id type="str" {
        key "JmFn3g9t"
        doc "setArenaRankID @0x1C570B4."
    }

    field fe_skill_info type="str" {
        key "Fnxab5CN"
        doc "setFeSkillInfo @0x1C572C0.  Packed elemental-skill data; kept as a string because its grammar is not decoded."
    }

    field unit_img_type type="i32::str" {
        key "2pAyFjmZ"
        doc "setUnitImgType @0x1C56A64.  Which art variant of the card unit to draw."
    }

    field unit_id type="i32::str" {
        key "pn16CNah"
        doc "The unit on their card.  Setter inlined; named from net/friends.kdl by key identity."
    }

    field unit_lv type="i32::str" {
        key "4A6LzBxr"
        doc "That unit's level.  Setter inlined."
    }

    field base_hp type="i32::str" {
        key "e7DK0FQT"
        doc "Setter inlined."
    }

    field base_atk type="i32::str" {
        key "67CApcti"
        doc "Setter inlined."
    }

    field base_def type="i32::str" {
        key "q08xLEsy"
        doc "Setter inlined."
    }

    field base_heal type="i32::str" {
        key "PWXu25cg"
        doc "Setter inlined."
    }

    field add_hp type="i32::str" {
        key "cuIWp89g"
        doc "Setter inlined."
    }

    field ext_hp type="i32::str" {
        key "TokWs1B3"
        doc "Setter inlined."
    }

    field add_atk type="i32::str" {
        key "RT4CtH5d"
        doc "Setter inlined."
    }

    field ext_atk type="i32::str" {
        key "t4m1RH6Y"
        doc "Setter inlined."
    }

    field add_def type="i32::str" {
        key "GcMD0hy6"
        doc "Setter inlined."
    }

    field ext_def type="i32::str" {
        key "e6mY8Z0k"
        doc "Setter inlined."
    }

    field add_heal type="i32::str" {
        key "C1HZr3pb"
        doc "Setter inlined."
    }

    field ext_heal type="i32::str" {
        key "X6jf8DUw"
        doc "Setter inlined."
    }

    field equipitem_id type="i32::str" {
        key "Ge8Yo32T"
        doc "First sphere.  setEquipItemID, NOT setMissionID -- the mislabel that once left every helper's sphere slot empty."
    }

    field equipitem_id2 type="i32::str" {
        key "mZA7fH2v"
        doc "Second sphere, from 7-star up."
    }

    field skill_id type="i32::str" {
        key "nj9Lw7mV"
        doc "Setter inlined."
    }

    field skill_lv type="i32::str" {
        key "3NbeC8AB"
        doc "Setter inlined."
    }

    field extra_skill_id type="i32::str" {
        key "iEFZ6H19"
        doc "Setter inlined."
    }

    field extra_skill_lv type="i32::str" {
        key "RQ5GnFE2"
        doc "Setter inlined."
    }

    field extra_passive_skill_id type="i32::str" {
        key "cP83zNsv"
        doc "Setter inlined."
    }

    field extra_passive_skill_id2 type="i32::str" {
