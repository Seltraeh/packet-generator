json AchievementSubjectMst {
    hash "H9ATfJ38"
    doc """
    F_ACHIEVEMENT_SUBJECT_MST -- the Randall Achievement list (873 unexpired of
    15,173; ported by tools/gen_achievement_mst.py).  response_class =
    AchievementSubjectMstResponse, readParam @0x13CB088, which reads exactly the
    eighteen keys below in this order; the shipped table has a nineteenth
    column, `8RVXhQjn`, that readParam ignores (constant 1 everywhere).

    ⚠ THIS TABLE IS NOT CARRIED BY getResponseObject.  Its wrapper hash is one of
    the 58 tags GameResponseParser::parseBodyTag routes to
    DataMstManager::saveAchievementSubjectMst, which writes the client's own MST
    file; DataMstManager::loadAchievementSubjectMst reads it back, and
    HomeScene::loadFiles re-runs that load, so a table sent once is live on the
    next trip through Home.  See the handbook on the two MST channels.

    ⚠ WHAT IS COUNTED IS THE ID BAND, NOT `cond_type`.  `cond_type` is the
    screen's filter and lumps unrelated conditions together -- value 1 alone
    covers logins (band 1000), Honor Points (2000), player level (3000), friends
    added (4000), favouriting a friend (5000) and editing a comment (6000).
    Reading progress off cond_type makes "25 Friends Added" report the login
    count and claim itself finished.  The thousand-band of `id` is what
    identifies a condition, across 80 bands; `cond_param` is its threshold,
    except in the three bands that name ONE mission (35000/36000 ordinary
    quests, 40000 a Grand Quest) where it is a mission id.  Two rows sit in a
    band that is not theirs and are handled by id: 7500 ("600 Mission Records
    Cleared", in the merit band) and 18100 (a LIST of six sphere ids).
    The mapping this server implements is in gme/common/Achievements.hpp.
    """

    field id type="i32::str" {
        key "M7SXoc31"
        doc "Subject id.  Kept as a string by readParam and by the user block (YTRJLG65) that joins to it."
    }

    field name type=str {
        key "xXdp1q0Y"
        doc "Display name, e.g. \"10 Daily Log Ins\".  Carries <br> markup."
    }

    field description type=str {
        key "qp37xTDh"
        doc "Long copy, e.g. \"Log in for a total of 10 days.\".  Same hash/name as item.kdl/gacha.kdl."
    }

    field category type="i32::str" {
        key "KT71m8Ae"
        doc "Tab on the achievement screen (1, 3, 4, 5), and one of the three filters GetAchievementInfo's query node sends back.  StrToInt -> +0x48."
    }

    field cond_type type="i32::str" {
        key "3rhygS9K"
        doc "WHAT is counted -- see the list in this struct's doc.  The screen's second filter.  StrToInt -> +0x4c."
    }

    field disp_unit type=str {
        key "5xaMdk8E"
        doc "Suffix printed after the progress figure; \"Achieved\" on every unexpired row."
    }

    field need_subject_id type=str {
        key "np4K1xtq"
        doc "Subject that must be finished first; empty on every unexpired row.  Same hash as the trade table's prerequisite."
    }

    field need_mission_id type=str {
        key "HSRhkf70"
        doc "Mission that must be cleared first; empty on every unexpired row.  Same hash/name as the progression gate in mission.kdl -- see the Grand Gaia gate notes."
    }

    field unk_sqL73JYw type="i32::str" {
        key "sqL73JYw"
        doc "StrToInt -> +0x98.  0 on 844 rows and 51 on 29.  // UNVERIFIED: no setter name survives and no reader has been traced; sent through unchanged."
    }

    field unk_a0d2suLZ type="i32::str" {
        key "a0d2suLZ"
        doc "StrToInt -> +0x9c.  999 on all but three rows, which carry 50.  // UNVERIFIED, same reason; looks like a cap or a level gate."
    }

    field unk_8RVXhQjn type="i32::str" {
        key "8RVXhQjn"
        doc "Constant 1 on all 873 unexpired rows, and AchievementSubjectMstResponse::readParam does NOT read it -- the client ignores whatever we send.  Modelled only so the ported table stays byte-faithful to the shipped dump; // UNVERIFIED by definition."
    }

    field disp_order type="i32::str" {
        key "8zaB7d6W"
        doc "StrToInt -> +0xa0.  72 distinct values in the hundreds-to-thousands, monotonic within a group.  // UNVERIFIED (named from shape): ordering on the list."
    }

    field cond_param type=str {
        key "t5R47iwj"
        doc "The threshold, kept STRING because it is not always a number: cond_type 0 packs \"<mission>,<x>,<turns>\"."
    }

    field cond_param2 type=str {
        key "qA7M9EjP"
        doc "Identical to cond_param on every shipped row.  NOTE the hash is `start_date` everywhere else (banner.kdl, gacha.kdl); this table reuses it for a second condition parameter, which is exactly the collision the handbook warns about."
    }

    field end_date type=str {
        key "SzV0Nps7"
        doc "Availability end.  tools/gen_achievement_mst.py drops rows already past it, so everything here is open."
    }

    field weekday type=str {
        key "fK15a73g"
        doc "Weekday restriction; empty on every unexpired row."
    }

    field point type="i32::str" {
        key "9hH0neGa"
        doc "Merit Points paid when the subject completes.  StrToInt -> +0x108.  Same hash/name as the Summoner Journal milestone points."
    }

    field img_frame type=str {
        key "yTPw0BD7"
        doc "Frame art for the row; empty on every unexpired row."
    }

    field reward_info type=str {
        key "JQ23rIvk"
        doc "Extra reward beyond the points, in the shared present vocabulary; empty on every unexpired row.  Same hash/name as the campaign's get_reward."
    }
}

json AchievementTradeMst {
    hash "82CcMZhp"
    doc """
    F_ACHIEVEMENT_TRADE_MST -- the Merit Point shop (181 unexpired of 32,500,
    after dropping one offer whose unit does not resolve).  response_class =
    AchievementTradeMstResponse, readParam @0x13CB5C0.  Delivered through
    parseBodyTag like its sibling above.
    """

    field id type="i32::str" {
        key "Mdgsh04u"
        doc "Offer id.  The user block (9j3ALx8I) joins on it."
    }

    field name type=str {
        key "hQ1SJZU9"
        doc "Display name, e.g. \"Blaze Lance\"."
    }

    field description type=str {
        key "qp37xTDh"
        doc "Blurb; empty on most rows."
    }

    field price type="i32::str" {
        key "3EWLm0sA"
        doc "Merit Points per purchase (50 .. 10,000)."
    }

    field need_subject_id type=str {
        key "np4K1xtq"
        doc "Subject that must be finished first; empty on every unexpired row."
    }

    field need_mission_id type=str {
        key "HSRhkf70"
        doc "Mission that must be cleared first; empty on every unexpired row."
    }

    field unk_sqL73JYw type="i32::str" {
        key "sqL73JYw"
        doc "// UNVERIFIED, as in AchievementSubjectMst; 0 throughout."
    }

    field unk_a0d2suLZ type="i32::str" {
        key "a0d2suLZ"
        doc "// UNVERIFIED, as in AchievementSubjectMst; 999 throughout."
    }

    field reward_info type=str {
        key "qBAb07rh"
        doc "What the purchase pays, colon-packed in the shared present vocabulary: \"<type>:<id>:<count>:<a>:<b>\" -- \"7:47300:1:0:0\" is one sphere 47300, \"6:18830:1:1:0\" one unit.  Kept string: mixed ids and flags."
    }

    field limit_count type="i32::str" {
        key "9Hau45Jj"
        doc "How many times one player may buy it; 1 on every unexpired row."
    }

    field unk_S8rdp9zk type="i32::str" {
        key "S8rdp9zk"
        doc "1 on every unexpired row.  // UNVERIFIED: likely a stock/enabled flag."
    }

    field start_date type=str {
        key "qA7M9EjP"
        doc "Availability start.  The ordinary meaning of this hash, unlike the subject table's reuse of it."
    }

    field end_date type=str {
        key "SzV0Nps7"
        doc "Availability end; the porter drops rows already past it."
    }
}

json AchievementDeliverRateMst {
    hash "1tJiqKgZ"
    doc """
    F_ACHIEVEMENT_DELIVER_RATE_MST -- how much Merit Point a delivered currency
    or unit is worth (53 rows).  response_class =
    AchievementDeliverRateMstResponse, readParam @0x13CAF08.  Delivered through
    parseBodyTag.

    Needed by the Deliver flow (AchievementDeliverRequest, vsaXI4M0), which is
    not built yet; ported now because it is the table the screen prices its
    dedicate panel from.
    """

    field kind type="i32::str" {
        key "oC6Dc1xp"
        doc "What is being delivered (0 on most rows).  // UNVERIFIED: named from position; AchievementDeliverRateMstList::find takes TWO ints, which this and `tier` supply."
    }

    field tier type="i32::str" {
        key "6yHMXYv1"
        doc "Second selector of the find(int,int) pair -- rarity or band.  // UNVERIFIED."
    }

    field rate type=str {
        key "ug9xV4Fz"
        doc "Points per unit delivered, a decimal string (\"2.00\", \"3.00\").  Same hash/name as the gacha weight column.  Kept string: it is fractional and the client parses it itself."
    }

    field band type=str {
        key "232id0qQ"
        doc "Colon-packed band the rate applies over, e.g. \"1:3:600:610:0\".  // UNVERIFIED shape: five numbers, not yet split."
    }
}
