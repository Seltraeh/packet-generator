json UserFavorite {
	doc "Favorited/locked unit entry in UserInfo (list key 3kcmQy7B).  Same wire triple as UnitFavoriteEntry — the UnitFavorite handler persists user_units.favorite_flg and UserInfo reports the locked set back here so locks survive a reload."

	field user_unit_id type="i32::str" {
		key "edy7fq3L"
		doc "Locked unit's user_units.user_unit_id.  Quoted decimal integer on the wire."
