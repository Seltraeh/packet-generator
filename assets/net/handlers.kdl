json GachaListReq {
    doc "Requests the summon/gacha list shown by the summon screen."

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key request block."
    }

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login information identifying the current user."
    }

    field mstRequests type="[MstUrlList]" {
        key "KeC10fuL"
        doc "MST versions requested by the client."
    }
}

json GachaActionReq {
    doc "Requests a summon pull from the currently selected summon gate."

    field signalKey type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key request block."
    }

    field loginInfo type="[LoginInfoReq]::size(1)" {
        key "IKqx1Cn9"
        doc "Login information identifying the current user."
    }

    field gachaActionInfo type="[GachaActionInfo]::size(1)" {
        key "1IR86sAv"
        doc "Selected gate and summon-count information."
    }

    field mstRequests type="[MstUrlList]" {
        key "KeC10fuL"
        doc "MST versions requested by the client."
    }
}

json GachaActionResp {
    doc "Response payload sent after resolving a summon pull."

    field signal_key type="[SignalKey]::size(1)" {
        key "6FrKacq7"
        doc "Signal key echoed back to the client."
    }

    field ope_user_unit type="[OpeUserUnitInfo]" {
        key "Km35HAXv"
        doc """
        Summoned unit ids and animation metadata.

        The client accepts multiple rows here for multi-summon result data.
        However, only the last row controls which unit gets the gate-opening
        animation.
        """
    }

    field unit_info type="[UserUnitInfo]" {
        key "qC2tJs4E"
        doc """
        Newly summoned owned-unit rows appended to the client unit list.
        """
    }

    field unit_dictionary type="[UserUnitDictionary]" {
        key "GV81ctzR"
        doc "Unit dictionary rows for units returned by this summon."
    }

    field team_info type="[UserTeamInfo]::size(1)" {
        key "fEi17cnx"
        doc "Updated user team state after spending summon currency."
    }
}

json CreateUserReq {
    doc "Creates the game user after the tutorial name/starter prompt."

    field loginInfo type="[LoginInfoReq]::size(1)" {
